# Four Eyes: the security policy for QNX 8.0, compiled into the image with
#   qnx/image/build.sh DIR --secpol=secure --policy=qnx/image/four-eyes.secpol
#
# Drafted by secpolgenerate on a running Four Eyes image (--secpol=open) while the agent answered a request, the
# head unit drove the car, the faulty-ECU tool sent malformed frames and the agent tried the bus directly; then edited
# by hand. The edits, all in the Four Eyes types:
#   - agent_t loses everything the generator saw it use when it went for the bus: the right to connect to vcan_t,
#     to attach a path (allow_attach /dev/vcan0, pathspace) and to create a public channel. Those uses came from the
#     agent's own probe, which is the attack this policy exists to refuse.
#   - user_root_t (the ssh shell) loses its connection to vcan_t. It keeps the right to start the head-unit bridge
#     and the test ECU under their own types (settypeid and gain_priv), but holds no fe_gate permission itself.
# The rules Four Eyes depends on, checked by tools/check_policy.py:
#   - only gate_t, body_t and ecu_t (the faulty-ECU test node) may connect to vcan_t, the bus;
#   - only vcan_t may attach /dev/vcan0, only gate_t /dev/fe/gate, only body_t /dev/fe/drive;
#   - agent_t may connect to gate_t and to devb_t (the filesystem, to read its weights and libc++; Unix permissions
#     keep it out of the gate's record directory) and nothing else, attaches nothing, and holds no spawn, fork,
#     priority, network or physical-memory ability; with procnto -P 22 it cannot reach the body controller's 30;
#   - of the fe_gate class, agent_t holds only propose and await, bridge_t only submit_turn and read.

# WARNING: Generated rules include some which may represent system or component
# design issues. Search for WARNING in the output.

# This represents a policy that should allow a system to perform all the
# same actions as have been observed since the policy generator has been
# running.

# There have been one or more uses of secpol_resmgr_attach() that can have
# permissions set for them in the policy. See the mount_point entries at
# the end.

# Don't want any default abilities
type default_rules;
allow default_rules self:ability {};

type agent_t;
type body_t;
type bridge_t;
type console_t;
type default;
type devb_t;
type devb_t__run;
type devc_pty_t;
type devc_pty_t__run;
type devc_t;
type devc_t__run;
type dhcpcd_t;
type dumper_t;
type dumper_t__run;
type ecu_t;
type fsevmgr_t;
type fsevmgr_t__run;
type gate_t;
type io_sock_t;
type io_sock_t__run;
type io_usb_t;
type mqueue_t;
type mqueue_t__run;
type pci_server_t;
type pipe_t;
type pipe_t__run;
type qconn_t;
type random_t;
type random_t__run;
type slogger_t;
type slogger_t__run;
type sshd_t;
type sshd_t__privsep;
type user_root_t;
type vcan_t;

ability iofunc/dup allow { root };
ability vfs/mount-blk allow { root };
ability vfs/pregrow allow { root };
ability vfs/relearn allow { root };
ability vfs/stats-clear allow { root };
ability vfs/fs-control allow { root };
ability network/privport allow { root };
ability network/rawsocket allow { root };
ability network/reuseport allow { root };
ability network/ipsec allow { root };
ability network/admin allow { root };
ability network/jailroot allow { root nonroot };

class fe_gate {
    propose
    await
    submit_turn
    read
};

# === Rules for type agent_t ============
# The agent: connects to the gate and to nothing else. No allow_attach, no pathspace, no public channel.
allow agent_t self:ability {
    nonroot
    prot_exec
    map_fixed
    channel_connect:gate_t,devb_t
};
allow agent_t gate_t:fe_gate {
    propose
    await
};

# === Rules for type body_t ============
allow_attach body_t {
    /dev/fe/drive
};
allow body_t self:ability {
    nonroot
    pathspace
    prot_exec
    priority:0-30
    map_fixed
    public_channel
    channel_connect:vcan_t
};

# === Rules for type bridge_t ============
allow bridge_t self:ability {
    nonroot
    prot_exec
    map_fixed
    channel_connect:body_t,gate_t
};
allow bridge_t gate_t:fe_gate {
    submit_turn
    read
};

# === Rules for type console_t ============
allow console_t self:ability {
    prot_exec
    pgrp
    map_fixed
};

# === Rules for type default ============
allow_link default {
    /proc/boot/libsecpol.so.1
    /usr/libexec/sshd-auth
};

# === Rules for type devb_t ============
allow_attach devb_t {
    mount:/
    /dev/hd0
    /dev/hd0t177
    /dev/hd0t178
    /dev/hd0t179
    /boot
    /system
    /data
};
allow devb_t self:ability {
    nonroot
    pathspace
    rsrcdbmgr
    prot_exec
    priority:0-30
    map_fixed
};
allow devb_t self:ability {
    setuid:20
    setgid:20
    mem_lock
    interrupt:14-15
    io:1
    public_channel
    channel_connect:slogger_t,pci_server_t,fsevmgr_t
    settypeid:devb_t__run
};
derive_type devb_t run devb_t__run;

# === Rules for type devb_t__run ============
allow_attach devb_t__run {
    /boot
    /system
    /data
};
allow devb_t__run self:ability {
    nonroot
    pathspace
    rsrcdbmgr
    prot_exec
    priority:0-30
    map_fixed
};
allow devb_t__run self:ability {
    setuid:20
    setgid:20
};

# === Rules for type devc_pty_t ============
allow_attach devc_pty_t {
    /dev/ttyp0
    /dev/ptyp0
    /dev/ttyp1
    /dev/ptyp1
    /dev/ttyp2
    /dev/ptyp2
    /dev/ttyp3
    /dev/ptyp3
    /dev/ttyp4
    /dev/ptyp4
    /dev/ttyp5
    /dev/ptyp5
    /dev/ttyp6
    /dev/ptyp6
    /dev/ttyp7
    /dev/ptyp7
};
allow devc_pty_t self:ability {
    nonroot
    setuid:37
    setgid:37
    pathspace
    rsrcdbmgr
    prot_exec
    map_fixed
    public_channel
    channel_connect:slogger_t
    settypeid:devc_pty_t__run
};
derive_type devc_pty_t run devc_pty_t__run;

# === Rules for type devc_t ============
allow_attach devc_t {
    /dev/ser1
    /dev/ser2
};
allow devc_t self:ability {
    nonroot
    pathspace
    rsrcdbmgr
    prot_exec
    interrupt:3-4
    io:0
    priority:0-25
    map_fixed
    public_channel
    settypeid:devc_t__run
};
derive_type devc_t run devc_t__run;

# === Rules for type devc_t__run ============
allow devc_t__run self:ability {
    nonroot
    priority:0-25
};

# === Rules for type dhcpcd_t ============
allow dhcpcd_t self:ability {
    nonroot
    spawn
    fork
    prot_exec
    pgrp
    map_fixed
    channel_connect:slogger_t,devb_t,random_t,pipe_t,io_sock_t
    network/privport
    network/rawsocket
    network/admin
    network/jailroot
};
allow dhcpcd_t self:ability {
    setuid:38
    channel_connect:io_sock_t
};

# === Rules for type dumper_t ============
allow_attach dumper_t {
    dumper+:/proc/dumper
};
allow dumper_t self:ability {
    nonroot
    pathspace
    mem_lock
    prot_exec
    dumper
    map_fixed
    public_channel
    channel_connect:slogger_t,devb_t
    settypeid:dumper_t__run
};
derive_type dumper_t run dumper_t__run;

# === Rules for type ecu_t ============
allow ecu_t self:ability {
    nonroot
    prot_exec
    map_fixed
    channel_connect:vcan_t
};

# === Rules for type fsevmgr_t ============
allow_attach fsevmgr_t {
    /dev/fsmgr
    /dev/fsnotify
};
allow fsevmgr_t self:ability {
    nonroot
    pathspace
    prot_exec
    map_fixed
    public_channel
    channel_connect:slogger_t,devb_t
    settypeid:fsevmgr_t__run
};
derive_type fsevmgr_t run fsevmgr_t__run;

# === Rules for type fsevmgr_t__run ============
allow fsevmgr_t__run self:ability {
    nonroot
    channel_connect:devb_t
};

# === Rules for type gate_t ============
allow_attach gate_t {
    /dev/fe/gate
};
allow gate_t self:ability {
    nonroot
    pathspace
    prot_exec
    map_fixed
    public_channel
    channel_connect:vcan_t,devb_t
};

# === Rules for type io_sock_t ============
allow_attach io_sock_t {
    socket+:/dev/socket/1
    socket+:/dev/socket/2
    socket+:/dev/socket/28
    socket+:/dev/socket/17
    socket+:/dev/socket/38
    socket+:/dev/socket/27
    /dev/tun
    /dev/tap
    /dev/vmnet
    mount:/
    /dev/io-sock
    /dev/bpf
    /dev/netmap
    /dev/pfil
    /dev/pf
};
allow io_sock_t self:ability {
    nonroot
    getid
    pathspace
    rlimit:14
    mem_phys:4273733632-4273737727
    mem_lock
    prot_exec
    interrupt:256-258
    io:0
    map_fixed
    public_channel
    able_create
    xprocess_query:33
    channel_connect:slogger_t,pci_server_t,devb_t,random_t
    settypeid:io_sock_t__run
};
derive_type io_sock_t run io_sock_t__run;

# === Rules for type io_sock_t__run ============
allow io_sock_t__run self:ability {
    nonroot
    getid
    channel_connect:devb_t
};

# === Rules for type mqueue_t ============
allow_attach mqueue_t {
    mqueue:/
    /dev/mqueue
};
allow mqueue_t self:ability {
    nonroot
    pathspace
    confset:19-20,32
    prot_exec
    map_fixed
    public_channel
    settypeid:mqueue_t__run
};
derive_type mqueue_t run mqueue_t__run;

# === Rules for type pci_server_t ============
allow_attach pci_server_t {
    all+:/dev/pci/server_id_1
};
allow pci_server_t self:ability {
    nonroot
    pathspace
    rsrcdbmgr
    # WARNING: Process pci-server mapped sysram addresses 0x80000000-0x80000fff using MAP_PHYS making it hard to secure
    mem_phys:0-4095,2147483648-2147487743,3758096384-3758100479,4026531840-4026535935,4273733632-4273737727
    mem_peer:33
    mem_lock
    prot_exec
    io:0
    map_fixed
    public_channel
    xprocess_query:34
    channel_connect:slogger_t
};

# === Rules for type pipe_t ============
allow_attach pipe_t {
    pipe:/
    /dev/pipe
};
allow pipe_t self:ability {
    nonroot
    pathspace
    prot_exec
    map_fixed
    public_channel
    settypeid:pipe_t__run
};
derive_type pipe_t run pipe_t__run;

# === Rules for type qconn_t ============
allow_attach qconn_t {
    /dev/profiler
};
allow qconn_t self:ability {
    nonroot
    pathspace
    prot_exec
    map_fixed
    public_channel
    channel_connect:devb_t,io_sock_t
    xprocess_debug:29
    xprocess_mem_read:29
    network/jailroot
};

# === Rules for type random_t ============
allow_attach random_t {
    /dev/random
    /dev/urandom
};
allow random_t self:ability {
    nonroot
    srandom
    channel_connect:devb_t
    settypeid:random_t__run
};
allow random_t self:ability {
    setuid:22
    setgid:22
    pathspace
    mem_lock
    prot_exec
    map_fixed
    public_channel
    channel_connect:slogger_t
};
derive_type random_t run random_t__run;

# === Rules for type random_t__run ============
allow random_t__run self:ability {
    nonroot
    srandom
};

# === Rules for type slogger_t ============
allow_attach slogger_t {
    /dev/slog
    /dev/slog2/notify
    /dev/slog2/stdout
    /dev/slog2/stderr
    /dev/console
};
allow slogger_t self:ability {
    nonroot
    pathspace
    prot_exec
    map_fixed
    public_channel
    xprocess_query:0,37-38,47
    channel_connect:random_t
    settypeid:slogger_t__run
};
derive_type slogger_t run slogger_t__run;

# === Rules for type slogger_t__run ============
allow slogger_t__run self:ability {
    nonroot
    xprocess_query:0,37-38,47
    channel_connect:random_t
};

# === Rules for type sshd_t ============
allow sshd_t self:ability {
    nonroot
    spawn
    fork
    prot_exec
    pgrp
    map_fixed
    chroot:0
    channel_connect:slogger_t,devb_t,random_t,pipe_t,io_sock_t
    settypeid:sshd_t__privsep,user_root_t
    network/privport
    network/jailroot
};
allow sshd_t self:ability {
    gain_priv:setuid,setgid
};
derive_type sshd_t privsep sshd_t__privsep;

# === Rules for type sshd_t__privsep ============
allow sshd_t__privsep self:ability {
    nonroot
    setuid:15
    setgid:15
};

# === Rules for type user_root_t ============
allow user_root_t self:ability {
    nonroot
    setuid:0
    setgid:0
    fork
    channel_connect:devb_t,io_sock_t
    network/jailroot
};
allow user_root_t self:ability {
    spawn_setuid:311-315
    spawn_setgid:311-315
    setgid:0
    spawn
    prot_exec
    signal:9,15
    pgrp
    map_fixed
    xprocess_query:20-22,24-25,29-30,33-34,37-38,43,47-48,310-313
    channel_connect:slogger_t,devb_t,pipe_t,body_t,gate_t
    settypeid:body_t,gate_t,agent_t,bridge_t,ecu_t
};
allow user_root_t self:ability {
    gain_priv:pathspace,prot_exec,priority,map_fixed,public_channel,channel_connect
};
# gain_priv lets the shell start a process under a type holding these permissions (on -T bridge_t ...); the shell
# itself holds none of them.
allow user_root_t self:ability {
    gain_priv:
        fe_gate:propose:gate_t, fe_gate:await:gate_t, fe_gate:submit_turn:gate_t, fe_gate:read:gate_t
};

# === Rules for type vcan_t ============
allow_attach vcan_t {
    /dev/vcan0
};
allow vcan_t self:ability {
    nonroot
    pathspace
    prot_exec
    priority:0-30
    map_fixed
    public_channel
};

# === Mount point permission rules ============
# These represent uses of secpol_resmgr_attach(). By using mount_point
# rules you can set the permissions used for these mount points.
# mount_point ... /dev/console;
# mount_point ... /dev/pci/server_id_1;
# mount_point ... /dev/ser1;
# mount_point ... /dev/ser2;
# mount_point ... /dev/fsmgr;
# mount_point ... /dev/fsnotify;
# mount_point ... /dev/random;
# mount_point ... /dev/socket/1;
# mount_point ... /dev/socket/2;
# mount_point ... /dev/socket/28;
# mount_point ... /dev/socket/17;
# mount_point ... /dev/socket/38;
# mount_point ... /dev/socket/27;
# mount_point ... /dev/tun;
# mount_point ... /dev/tap;
# mount_point ... /dev/vmnet;
# mount_point ... /;
# mount_point ... /dev/io-sock/;
# mount_point ... /dev/bpf;
# mount_point ... /dev/netmap;
# mount_point ... /dev/pfil;
# mount_point ... /dev/pf;
# mount_point ... /dev/vcan0;
# mount_point ... /dev/fe/drive;
# mount_point ... /dev/fe/gate;
