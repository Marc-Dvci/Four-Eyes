# Variables the code reads. None is needed for the demo.
# 1 = the car page follows the QNX guest (fe-bridge over ssh at 127.0.0.1:2242); unset = demo mode, no QNX.
FE_GUEST=
# Where the web files are (the Docker image sets it).
APP_WEB_DIR=
# Set by scripts/coverage_core.sh: build the C core with gcov.
FE_COVERAGE=
# C compiler for the host build of the core (default cc).
CC=
